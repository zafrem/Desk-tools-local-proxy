{
  "name": "desk-tools-local-proxy",
  "version": "0.2.0",
  "description": "Local WebSocket bridge between the Desk-tools web app and SSH, Telnet, MySQL, PostgreSQL, Hive and Trino. Runs entirely on your machine; nothing is sent to any third party.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "desk-tools-local-proxy": "index.js"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "src",
    "PROTOCOL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test --test-force-exit \"test/*.test.js\""
  },
  "dependencies": {
    "hive-driver": "^1.0.1",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
  }
}
